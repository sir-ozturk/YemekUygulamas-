<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="YemekUygulaması.Admin" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Yemek Uygulaması</title>
    <link href="Kullanici.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        .auto-style1 {
            width: 100%;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">

        <div style="height: 150px; width: 700px; margin-left: 300px; background-color: #ce7171">
            <asp:Image ID="Image1" runat="server" Height="153px" ImageUrl="~/görseller/Gemini_Generated_Image_p0td6xp0td6xp0td.png" Width="699px" />
        </div>
        <div style="height: 20px; width: 700px; margin-left: 300px;"></div>

        <div style="margin-left: 300px; width: 700px;">
            <table style="width: 100%; border-collapse: collapse;">
                <tr>
                    <td style="width: 250px; vertical-align: top; background-color: dodgerblue; padding: 10px; height: 400px;">
                        <table class="auto-style1">
                            <tr>
                                <td><strong>MENÜLER</strong></td>
                            </tr>
                            <tr>
                                <td>&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="border: thin solid #FFFFFF"><a href="Kategoriler.aspx">KATEGORİLER</a></td>
                            </tr>
                            <tr>
                                <td style="border: thin solid #FFFFFF">YEMEKLER</td>
                            </tr>
                            <tr>
                                <td style="border: thin solid #FFFFFF">YORUMLAR</td>
                            </tr>
                            <tr>
                                <td style="border: thin solid #FFFFFF">MESAJLAR</td>
                            </tr>
                            <tr>
                                <td style="border: thin solid #FFFFFF">GÜNÜN YEMEĞİ</td>
                            </tr>
                            <tr>
                                <td style="border: thin solid #FFFFFF">ÖNERİLER</td>
                            </tr>
                            <tr>
                                <td style="border: thin solid #FFFFFF">HAKKIMIZDA</td>
                            </tr>
                        </table>
                        <br />
                        <br />
                        
                    </td>

                    <td style="width: 50px;"></td>

                    <td style="width: 400px; vertical-align: top; background-color: dodgerblue; padding: 15px; height: 400px;">
                        <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                        </asp:ContentPlaceHolder>
                    </td>
                </tr>
            </table>
        </div>

    </form>
</body>
</html>